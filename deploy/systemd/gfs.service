[Unit]
Description=GFS Backend Service
After=network.target

[Service]
Type=simple
User=${APP_USER}
Group=${APP_GROUP}
WorkingDirectory=${APP_DIR}
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/broadcast/install.env
ExecStart=${APP_DIR}/venv/bin/python -m hypercorn main:app --workers ${WEB_CONCURRENCY:-2} --bind 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
